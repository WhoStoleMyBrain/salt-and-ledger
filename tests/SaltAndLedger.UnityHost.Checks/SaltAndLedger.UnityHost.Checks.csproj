<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SaltAndLedger.Simulation/SaltAndLedger.Simulation.csproj" />
    <Compile Include="../../unity/Assets/SaltAndLedger/Runtime/ArchipelagoLab/ArchipelagoLabSession.cs" Link="ArchipelagoLabSession.cs" />
    <Compile Include="../../unity/Assets/SaltAndLedger/Runtime/ArchipelagoLab/LocalWorldGenerationConfiguration.cs" Link="LocalWorldGenerationConfiguration.cs" />
    <Compile Include="../../unity/Assets/SaltAndLedger/Runtime/ArchipelagoLab/EconomicText.cs" Link="EconomicText.cs" />
    <Compile Include="../../unity/Assets/SaltAndLedger/Runtime/ArchipelagoLab/VoyageVisualInterval.cs" Link="VoyageVisualInterval.cs" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
