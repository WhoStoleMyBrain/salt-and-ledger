/* Illustrated Maritime Ledger: shared material and interaction tokens.
   Text sizes remain owned by ArchipelagoTextScale / ArchipelagoLab.uss. */
.sl-theme {
    --sl-sea-900: #103b45;
    --sl-sea-700: #2f6c73;
    --sl-navy-950: #0d2631;
    --sl-paper-100: #f4ecd8;
    --sl-paper-200: #e9dfc6;
    --sl-paper-300: #ddd0ae;
    --sl-ink-900: #26343b;
    --sl-gold-500: #c4a36a;
    --sl-gold-ink: #775527;
    --sl-green-700: #396c60;
    --sl-rust-600: #a45139;
    --sl-rust-ink: #93452f;
    --sl-border-300: #b7aa8f;
    --sl-muted-600: #536067;
    --sl-paper-selection: #d2e0d2;
    --sl-paper-warning: #f1dfc4;
    --sl-focus-light: #ffe6a6;
    --sl-space-xs: 4px;
    --sl-space-sm: 8px;
    --sl-space-md: 12px;
    --sl-space-lg: 18px;
    color: var(--sl-paper-100);
}

.sl-theme .archipelago-lab { background-color: var(--sl-navy-950); }
.sl-hud { background-color: var(--sl-navy-950); border-bottom-width: 1px; border-bottom-color: var(--sl-gold-500); color: var(--sl-paper-100); }
.sl-hud .unity-label { color: var(--sl-paper-100); }
.sl-hud .sl-stat-label { color: #b7cdca; font-size: var(--sl-caption); }
.sl-hud .brand { color: var(--sl-gold-500); }
.sl-mode-nav { flex-direction: row; align-items: center; flex-shrink: 0; background-color: var(--sl-sea-900); border-bottom-width: 1px; border-bottom-color: #50767a; padding: 4px 8px; }
.sl-mode-nav .unity-button { background-color: transparent; border-color: transparent; margin: 0 6px 0 0; padding: 4px 12px; color: var(--sl-paper-100); }
.sl-mode-nav .unity-button:hover { background-color: var(--sl-sea-700); border-color: #7fa6a5; }
.sl-mode-nav .sl-selected, .sl-mode-nav .selected-tab { background-color: var(--sl-sea-700); border-color: var(--sl-gold-500); border-bottom-width: 3px; color: var(--sl-paper-100); }
.sl-mode-nav .unity-button:focus { border-color: var(--sl-focus-light); border-width: 2px; }
.sl-mode-nav .sl-inline { justify-content: center; }

.sl-paper, .sl-theme .trade-modal, .sl-theme .industry-modal, .sl-theme .run-card {
    background-color: var(--sl-paper-200);
    color: var(--sl-ink-900);
    border-color: var(--sl-gold-500);
    border-width: 1px;
    border-radius: 6px;
}
.sl-paper .unity-label, .sl-theme .trade-modal .unity-label, .sl-theme .industry-modal .unity-label, .sl-theme .run-card .unity-label { color: var(--sl-ink-900); }
.sl-paper .unity-base-field__label, .sl-paper .unity-toggle__label, .sl-paper .unity-toggle__text,
.sl-theme .trade-modal .unity-base-field__label, .sl-theme .industry-modal .unity-base-field__label,
.sl-theme .industry-modal .unity-toggle__label, .sl-theme .industry-modal .unity-toggle__text,
.sl-theme .run-card .unity-base-field__label, .sl-theme .run-card .unity-toggle__label { color: var(--sl-ink-900); }
.sl-paper .help, .sl-paper .run-footnote, .sl-paper .compact, .sl-paper .sl-muted,
.sl-theme .trade-modal .help, .sl-theme .industry-modal .help, .sl-theme .run-card .run-footnote { color: var(--sl-muted-600); }
.sl-paper .run-heading, .sl-paper .selection-title, .sl-paper .sl-heading,
.sl-theme .trade-modal .modal-title, .sl-theme .industry-modal .modal-title { color: var(--sl-ink-900); }
.sl-paper .eyebrow, .sl-paper .run-eyebrow, .sl-paper .section-label,
.sl-theme .trade-modal .eyebrow, .sl-theme .industry-modal .eyebrow, .sl-theme .industry-modal .section-label,
.sl-theme .run-card .run-eyebrow { color: var(--sl-gold-ink); }
.sl-paper .run-copy, .sl-paper .run-objective, .sl-paper .commission-requirement, .sl-paper .commission-selections { color: var(--sl-ink-900); }
.sl-card { background-color: var(--sl-paper-100); border-color: var(--sl-border-300); border-width: 1px; border-radius: 4px; padding: var(--sl-space-md); }
.sl-header { flex-direction: row; align-items: center; border-bottom-color: var(--sl-border-300); border-bottom-width: 1px; padding-bottom: var(--sl-space-sm); margin-bottom: var(--sl-space-sm); }
.sl-heading { font-size: var(--sl-heading); -unity-font-style: bold; white-space: normal; margin: 0; padding: 0; }
.sl-group-label { font-size: var(--sl-caption); -unity-font-style: bold; color: var(--sl-gold-ink); white-space: normal; }
.sl-section-title { font-size: var(--sl-emphasis); -unity-font-style: bold; white-space: normal; margin: 0 0 8px 0; padding: 0; }
.sl-paper .sl-section-title { color: var(--sl-ink-900); }
.sl-paper .command-muted { color: var(--sl-muted-600); }
.sl-primary-value { font-size: var(--sl-emphasis); -unity-font-style: bold; white-space: normal; }
.sl-inline { flex-direction: row; align-items: center; }
.sl-muted { font-size: var(--sl-caption); white-space: normal; color: var(--sl-muted-600); }
.sl-metric { background-color: var(--sl-paper-100); border-left-width: 2px; border-left-color: var(--sl-gold-500); padding: 8px 12px; margin-right: 8px; min-width: 0; }
.sl-metric .unity-label { white-space: normal; margin: 0; }
.sl-metric.sl-warning { border-left-color: var(--sl-rust-600); }
.sl-problem { flex-direction: row; align-items: center; padding: 7px 10px; background-color: var(--sl-paper-selection); border-left-width: 3px; border-left-color: var(--sl-green-700); }
.sl-problem.sl-warning { background-color: var(--sl-paper-warning); border-left-color: var(--sl-rust-600); }
.sl-problem .unity-label { color: var(--sl-ink-900); white-space: normal; flex-shrink: 1; }
.sl-problem.sl-calm { background-color: var(--sl-paper-selection); border-left-color: var(--sl-green-700); }
.sl-theme .sl-warning, .sl-paper .sl-warning, .sl-paper .error,
.sl-theme .trade-modal .error, .sl-theme .industry-modal .error { color: var(--sl-rust-ink); }
.sl-theme .sl-success, .sl-paper .sl-success { color: var(--sl-green-700); }
.sl-goods-row { flex-direction: row; align-items: center; min-height: var(--sl-table-row); border-bottom-width: 1px; border-bottom-color: var(--sl-border-300); }
.sl-recipe { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 7px 0; }
.sl-recipe-good { flex-direction: row; align-items: center; padding: 4px 8px; margin: 0 5px 4px 0; border-radius: 4px; background-color: var(--sl-paper-100); }
.sl-recipe-good .unity-label { color: var(--sl-ink-900); white-space: normal; }
.sl-recipe-arrow { font-size: var(--sl-emphasis); margin: 0 9px 4px 4px; color: var(--sl-gold-ink); }

.sl-theme .unity-button { background-color: var(--sl-sea-900); border-color: #607c79; color: var(--sl-paper-100); }
.sl-theme .unity-button:hover { background-color: var(--sl-sea-700); border-color: var(--sl-gold-500); }
.sl-theme .unity-button:active { background-color: var(--sl-navy-950); }
.sl-theme .unity-button.primary, .sl-theme .unity-button.sl-primary { background-color: var(--sl-green-700); border-color: #527c6c; color: var(--sl-paper-100); }
.sl-theme .unity-button.primary:hover, .sl-theme .unity-button.sl-primary:hover { background-color: #2c574d; border-color: var(--sl-gold-500); }
.sl-theme .unity-button.sl-danger { background-color: var(--sl-rust-600); border-color: #8a4331; }
.sl-theme .unity-button.sl-danger:hover { background-color: #813c2b; }
.sl-theme .unity-button:disabled { background-color: #506365; color: #d8ded5; border-color: #63716e; }
.sl-theme .unity-button.sl-secondary { background-color: var(--sl-paper-100); color: var(--sl-ink-900); border-color: var(--sl-border-300); }
.sl-theme .unity-button.sl-secondary:hover { background-color: var(--sl-paper-selection); border-color: var(--sl-green-700); }
.sl-theme .unity-button.sl-selected, .sl-theme .unity-button.selected-tab { background-color: var(--sl-green-700); border-color: var(--sl-gold-500); color: var(--sl-paper-100); }

.sl-paper .unity-base-field__input, .sl-theme .trade-modal .unity-base-field__input, .sl-theme .industry-modal .unity-base-field__input, .sl-theme .run-card .unity-base-field__input { background-color: var(--sl-paper-100); border-color: var(--sl-border-300); color: var(--sl-ink-900); }
.sl-paper .unity-base-popup-field__text, .sl-theme .trade-modal .unity-base-popup-field__text, .sl-theme .industry-modal .unity-base-popup-field__text, .sl-theme .run-card .unity-base-popup-field__text { color: var(--sl-ink-900); }
.sl-paper .unity-base-field__input:focus, .sl-theme .trade-modal .unity-base-field__input:focus, .sl-theme .industry-modal .unity-base-field__input:focus { border-color: var(--sl-sea-900); border-width: 2px; }
.sl-paper .unity-base-popup-field__arrow, .sl-theme .trade-modal .unity-base-popup-field__arrow, .sl-theme .industry-modal .unity-base-popup-field__arrow { background-color: var(--sl-sea-900); }
.sl-paper .unity-toggle__checkmark, .sl-theme .industry-modal .unity-toggle__checkmark { background-color: var(--sl-paper-100); border-color: var(--sl-muted-600); }
.sl-paper .unity-toggle__input:checked .unity-toggle__checkmark, .sl-theme .industry-modal .unity-toggle__input:checked .unity-toggle__checkmark { background-color: var(--sl-green-700); border-color: var(--sl-sea-900); }
.sl-paper .unity-scroller, .sl-paper .unity-scroller .unity-base-slider__tracker,
.sl-theme .trade-modal .unity-scroller, .sl-theme .industry-modal .unity-scroller { background-color: var(--sl-paper-300); }
.sl-paper .unity-scroller .unity-base-slider__dragger,
.sl-theme .trade-modal .unity-scroller .unity-base-slider__dragger,
.sl-theme .industry-modal .unity-scroller .unity-base-slider__dragger { background-color: var(--sl-muted-600); }

/* Adapters keep the established Harbor, Industry and planner layout/commands intact. */
.sl-theme .trade-modal .modal-heading, .sl-theme .industry-modal .modal-heading { border-bottom-width: 1px; border-bottom-color: var(--sl-border-300); padding-bottom: 8px; }
.ui-narrow.ui-text-default .trade-modal .modal-heading { padding-bottom: 0; }
.ui-narrow.ui-text-default .trade-modal .sl-illustration-small { width: 88px; height: 48px; }
/* Keep both exact v3 paid-trade proposals visible at 1366x768 Default.
   Use the available form width rather than reducing text or control sizes. */
.ui-narrow.ui-text-default .trade-order > .unity-base-field { flex-direction: row; align-items: center; }
.ui-narrow.ui-text-default .trade-order > .unity-base-field > .unity-base-field__label {
    width: 128px;
    min-width: 128px;
    max-width: 128px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    -unity-text-align: middle-left;
}
.ui-narrow.ui-text-default .trade-order > .unity-base-field > .unity-base-field__input { flex-grow: 1; min-width: 0; }
.ui-narrow.ui-text-default .trade-modal .trade-quote-card { padding-top: 6px; padding-bottom: 6px; margin-top: 6px; }
.sl-theme .trade-modal .trade-header, .sl-theme .industry-modal .construction-bar { background-color: var(--sl-paper-100); color: var(--sl-ink-900); }
.sl-theme .trade-goods-row { background-color: var(--sl-paper-100); color: var(--sl-ink-900); border-bottom-color: var(--sl-border-300); }
.sl-theme .trade-goods-row:hover { background-color: #e2e7d6; }
.sl-theme .trade-goods-row.selected-good { background-color: var(--sl-paper-selection); border-left-color: var(--sl-green-700); }
.sl-theme .trade-modal .trade-goods-row.stock-short > .trade-good-name,
.sl-theme .trade-modal .trade-cell.stock-short { color: var(--sl-rust-ink); }
.sl-theme .trade-modal .trade-goods-row.stock-adequate > .trade-good-name,
.sl-theme .trade-modal .trade-cell.stock-adequate { color: #285a4d; }
.sl-theme .trade-modal .commodity-comparison { background-color: var(--sl-paper-100); border-color: var(--sl-border-300); border-width: 1px; }
.sl-theme .trade-modal .commodity-comparison:hover, .sl-theme .trade-modal .commodity-comparison.selected-good { background-color: var(--sl-paper-selection); }
.sl-theme .trade-modal .commodity-comparison .unity-label { color: var(--sl-ink-900); }
.sl-theme .run-card .commission-progress .unity-progress-bar__title { color: var(--sl-paper-100); }
.sl-theme .run-card .commission-progress .unity-progress-bar__progress { background-color: var(--sl-green-700); }
.sl-theme .trade-column-header { background-color: var(--sl-paper-300); }
.sl-theme .trade-column-header .unity-label { -unity-font-style: bold; color: var(--sl-ink-900); }
.sl-theme .trade-quote-card, .sl-theme .warehouse-quote, .sl-theme .industry-policy,
.sl-theme .industry-modal .policy-preview, .sl-paper .itinerary-quote { background-color: var(--sl-paper-100); border-color: var(--sl-border-300); }
.sl-theme .buy-card { border-left-width: 3px; border-left-color: var(--sl-green-700); }
.sl-theme .sell-card { border-left-width: 3px; border-left-color: var(--sl-gold-500); }
.sl-theme .modal-footer, .sl-theme .storage-row, .sl-theme .policy-rule, .sl-paper .itinerary-action { border-color: var(--sl-border-300); }
.sl-theme .storage-header { background-color: var(--sl-paper-300); }
.sl-theme .industry-modal .transfer-note { color: var(--sl-green-700); }
.sl-theme .industry-modal .policy-rule-name { color: var(--sl-gold-ink); }
.sl-paper .commission-selected, .sl-theme .run-card.commission-selected { background-color: var(--sl-paper-selection); border-color: var(--sl-green-700); }
.sl-paper .commission-progress-card, .sl-paper .run-card { background-color: var(--sl-paper-100); }
.sl-paper .policy-card, .sl-paper .preview, .sl-paper .city-funds { background-color: var(--sl-paper-100); color: var(--sl-ink-900); }
.sl-paper .voyage-bar { background-color: var(--sl-paper-100); color: var(--sl-ink-900); border-top-width: 1px; border-top-color: var(--sl-border-300); }
.sl-paper .ledger-event { color: var(--sl-ink-900); border-bottom-color: var(--sl-border-300); }

/* Small drawings are source-native vector geometry, never downloaded image overlays. */
.sl-glyph { width: 30px; height: 30px; flex-shrink: 0; margin-right: 6px; }
.sl-glyph-small { width: 24px; height: 24px; margin-right: 4px; }
.sl-glyph-large { width: 48px; height: 48px; margin-right: 10px; }
.ui-large-layout .sl-glyph { width: 34px; height: 34px; }
.ui-large-layout .sl-glyph-small { width: 28px; height: 28px; }
.ui-large-layout .sl-glyph-large { width: 56px; height: 56px; }
.sl-illustration { width: 156px; height: 92px; flex-shrink: 0; margin-right: 12px; overflow: hidden; border-radius: 4px; }
.sl-illustration-small { width: 112px; height: 66px; }
.sl-illustration-banner { width: auto; height: 140px; align-self: stretch; margin-right: 0; }
.ui-large-layout .sl-illustration-small { width: 128px; height: 76px; }

.sl-theme .map-frame { background-color: var(--sl-sea-900); border-color: #6b8174; }
.sl-theme .archipelago-map > .port-marker { background-color: var(--sl-navy-950); border-color: var(--sl-gold-500); color: var(--sl-paper-100); }
.sl-theme .archipelago-map > .port-marker:hover { background-color: var(--sl-sea-700); border-color: var(--sl-focus-light); }
.sl-theme .archipelago-map > .ship-marker { flex-direction: row; align-items: center; justify-content: center; border-radius: 5px; }
.sl-theme .archipelago-map > .player-marker { background-color: var(--sl-paper-200); border-color: var(--sl-gold-500); color: var(--sl-ink-900); }
.sl-theme .archipelago-map > .npc-marker { background-color: #a7c8c5; border-color: #78a8ac; color: var(--sl-ink-900); }
.sl-theme .archipelago-map > .selected-marker, .sl-theme .archipelago-map > .ship-marker:focus, .sl-theme .archipelago-map > .port-marker:focus { border-color: var(--sl-focus-light); border-width: 3px; }
.sl-theme .archipelago-map > .sl-marker-blocked { border-color: #d99e7d; }
.sl-theme .archipelago-map > .sl-marker-active { border-bottom-color: #79af87; }
.sl-map-ship-glyph { width: 22px; height: 25px; margin: 0; }
.ui-text-compact .sl-map-ship-glyph { width: 18px; height: 22px; }
.ui-large-layout .sl-map-ship-glyph { width: 26px; height: 29px; }
.sl-map-ship-label { font-size: var(--sl-caption); color: var(--sl-ink-900); margin: 0; padding: 0; }
.sl-map-blocked-badge { position: absolute; right: -5px; top: -8px; width: 18px; height: 20px; background-color: var(--sl-rust-600); color: var(--sl-paper-100); border-width: 1px; border-color: var(--sl-paper-100); border-radius: 10px; -unity-text-align: middle-center; font-size: var(--sl-caption); -unity-font-style: bold; margin: 0; padding: 0; }
.sl-theme .route-distance { color: var(--sl-paper-100); background-color: var(--sl-navy-950); border-width: 1px; border-color: #567b7d; }

.sl-theme .unity-button > .unity-label { color: var(--sl-paper-100); }
.sl-theme .unity-button.sl-secondary > .unity-label, .sl-theme .trade-goods-row > .unity-label { color: var(--sl-ink-900); }
.sl-theme .ship-marker > .sl-map-ship-label { color: var(--sl-ink-900); }
.sl-theme .unity-button:focus { border-width: 2px; border-color: var(--sl-focus-light); }
.sl-paper .unity-button:focus, .sl-theme .trade-modal .unity-button:focus, .sl-theme .industry-modal .unity-button:focus, .sl-theme .run-card .unity-button:focus { border-color: var(--sl-ink-900); border-width: 3px; }
.sl-theme .archipelago-map > .ship-marker.selected-marker, .sl-theme .archipelago-map > .ship-marker:focus { border-color: var(--sl-focus-light); border-width: 3px; }
