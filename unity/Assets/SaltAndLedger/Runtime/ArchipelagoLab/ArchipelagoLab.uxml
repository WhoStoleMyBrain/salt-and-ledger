<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ArchipelagoLab.uss" />
    <ui:Style src="ArchipelagoRunExperience.uss" />
    <ui:Style src="ArchipelagoCommandDeck.uss" />
    <ui:Style src="IllustratedMaritime.uss" />
    <ui:VisualElement name="archipelagoLab" class="archipelago-lab">
        <ui:VisualElement name="topBar" class="top-bar">
            <ui:Label text="SALT &amp; LEDGER" class="brand" />
            <ui:Label name="dayLabel" text="DAY 0" class="day" />
            <ui:Label name="cashLabel" class="top-summary" />
            <ui:Label name="playbackLabel" class="playback-label" />
            <ui:Button name="playButton" text="Play" class="primary" />
            <ui:Button name="pauseButton" text="Pause" />
            <ui:Button name="nextDayButton" text="Next day" />
            <ui:DropdownField name="speedDropdown" class="speed-picker" tooltip="Presentation speed. The same number of days and commands always has the same economic result." />
            <ui:Button name="resetButton" text="Restart" tooltip="Confirm before restoring this run's selected challenge and company." />
        </ui:VisualElement>
        <ui:VisualElement name="mainLayout" class="main-layout">
            <ui:VisualElement class="map-side">
                <ui:VisualElement class="row scenario-bar">
                    <ui:Label name="challengeLabel" text="Sandbox · build your enterprise at your own pace." class="challenge-summary" />
                    <ui:Button name="startChallengeButton" text="New Run" tooltip="Confirm before choosing another challenge and starting company." />
                    <ui:Button name="startSandboxButton" text="New sandbox" />
                </ui:VisualElement>
                <ui:VisualElement class="map-frame">
                    <ui:VisualElement name="mapContainer" class="archipelago-map" />
                    <ui:VisualElement class="map-footer">
                        <ui:DropdownField name="shipPicker" class="fleet-picker" tooltip="Inspect any vessel, including ships sharing a route position." />
                        <ui:Button name="playerShipButton" text="Select your ship" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="contextScroll" mode="Vertical" class="context-panel">
                <ui:Label name="selectionTitle" class="selection-title" />
                <ui:Label name="selectionSubtitle" class="selection-subtitle" />
                <ui:VisualElement name="portContext">
                    <ui:Label name="marketCashLabel" class="summary" />
                    <ui:VisualElement class="commodity-row commodity-header">
                        <ui:Label text="MARKET" class="commodity-name" />
                        <ui:Label text="STOCK" class="commodity-cell" />
                        <ui:Label text="SELL" class="commodity-cell" />
                        <ui:Label text="BUY" class="commodity-cell" />
                    </ui:VisualElement>
                    <ui:VisualElement name="marketRows" />
                    <ui:Label text="Prices are the next marginal unit, from your perspective." class="help" />
                    <ui:Label name="dockedLabel" class="compact" />
                    <ui:Label name="economySummaryLabel" class="compact" />
                    <ui:Foldout name="economyFoldout" text="Local industry &amp; consumption" value="false">
                        <ui:Label name="productionLabel" class="help" />
                        <ui:Label text="RECURRING DEMAND" class="section-label" />
                        <ui:Label name="consumptionLabel" class="help" />
                        <ui:Label text="RECENT SHIP ACTIVITY" class="section-label" />
                        <ui:Label name="deliveriesLabel" class="help" />
                    </ui:Foldout>
                    <ui:Foldout name="pricingFoldout" text="How these prices are configured" value="false">
                        <ui:Label name="pricingLabel" class="help" />
                    </ui:Foldout>
                </ui:VisualElement>
                <ui:VisualElement name="shipContext" class="hidden">
                    <ui:Label name="shipStateLabel" class="summary" />
                    <ui:Label name="shipCargoLabel" class="summary" />
                    <ui:Label name="shipControlLabel" class="help" />
                    <ui:Foldout name="shipPolicyFoldout" text="Merchant policy &amp; current decision" value="true">
                        <ui:Label name="shipPolicyLabel" class="help" />
                        <ui:Label name="shipDecisionLabel" class="help" />
                    </ui:Foldout>
                </ui:VisualElement>
                <ui:VisualElement class="row context-actions">
                    <ui:Button name="openTradeButton" text="Harbor · trade / load" class="primary" />
                    <ui:Button name="openIndustryButton" text="Your industries" />
                </ui:VisualElement>
                <ui:VisualElement name="voyageBar" class="voyage-bar">
                    <ui:Label name="voyageLabel" class="voyage-copy" />
                    <ui:Button name="sailButton" text="Confirm voyage" class="primary" />
                </ui:VisualElement>
                <ui:Label name="latestEventLabel" class="latest-event" />
                <ui:Foldout name="activityFoldout" text="Captain's log · recent events (60 maximum)" value="false" class="activity-foldout">
                    <ui:ScrollView mode="Vertical" class="activity-scroll">
                        <ui:VisualElement name="activityEntries" />
                    </ui:ScrollView>
                </ui:Foldout>

                <ui:Foldout name="mapHelpFoldout" text="Map controls and legend" value="false">
                    <ui:Label name="mapHint" class="map-hint" />
                        <ui:Label text="Gold P · you     Blue markers · NPC merchants     Dashed · sea routes" class="map-legend" />
                    <ui:Label text="Distances use abstract units. Straight sea connections do not use coastline pathfinding." class="help" />
                </ui:Foldout>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Label name="statusLabel" class="status" />
        <ui:VisualElement name="tradeBackdrop" class="modal-backdrop hidden">
            <ui:VisualElement name="tradeDialog" class="trade-modal" focusable="true">
                <ui:VisualElement class="modal-heading">
                    <ui:VisualElement class="modal-heading-copy">
                        <ui:Label text="HARBOR · MARKET / SHIP / COMPANY" class="eyebrow" />
                        <ui:Label name="tradeTitle" class="modal-title" />
                    </ui:VisualElement>
                    <ui:Label name="tradeDay" class="day" />
                    <ui:Button name="closeTradeButton" text="Close  ×" tooltip="Close the exchange. Escape also closes; playback stays paused." />
                </ui:VisualElement>
                <ui:Label name="tradeHeader" class="trade-header" />
                <ui:ScrollView name="tradeContentScroll" mode="Vertical" class="trade-content-scroll">
                  <ui:VisualElement class="trade-body">
                    <ui:VisualElement class="trade-market">
                        <ui:VisualElement class="trade-goods-row trade-column-header">
                            <ui:Label text="COMMODITY" class="trade-good-name" />
                            <ui:Label text="TOWN" class="trade-cell" />
                            <ui:Label text="SHIP" class="trade-cell" />
                            <ui:Label text="LOCAL" class="trade-cell" />
                            <ui:Label text="SELL&#10;BID" class="trade-cell" />
                            <ui:Label text="BUY&#10;ASK" class="trade-cell" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tradeGoodsRows" />
                        <ui:Label text="BUY: company pays market · SELL: market pays company. Quotes are marginal coins per whole good." class="help" />
                        <ui:Label name="harborStockExplanation" class="help" />
                        <ui:Foldout name="harborProduction" text="Local production and blockers" value="false">
                            <ui:Label name="harborProductionLabel" class="help" />
                        </ui:Foldout>
                        <ui:Button name="harborIndustryButton" text="Build / manage local industries" />
                        <ui:Button name="harborRoutePlannerButton" text="Selected ship / Route planner" class="hidden" />
                        <ui:Label name="tradeGoodDescription" class="trade-description" />
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-order">
                        <ui:DropdownField name="goodDropdown" label="Good" />
                        <ui:DropdownField name="harborTradeTarget" label="Paid trade stock" />
                        <ui:VisualElement class="row quantity-row">
                            <ui:Button name="quantityMinus" text="−" />
                            <ui:TextField name="quantityField" label="Quantity" value="2" />
                            <ui:Button name="quantityPlus" text="+" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row quantity-shortcuts">
                            <ui:Button name="quantityOne" text="1" />
                            <ui:Button name="quantityFive" text="5" />
                            <ui:Button name="quantityMaxBuy" text="Max buy" />
                            <ui:Button name="quantityMaxSell" text="Max sell" />
                        </ui:VisualElement>
                        <ui:VisualElement class="trade-quote-card buy-card">
                            <ui:Label text="PAID PURCHASE FROM MARKET" class="eyebrow" />
                            <ui:Label name="buyPreviewLabel" class="trade-exact" />
                            <ui:Button name="buyButton" text="Buy now" class="primary" />
                        </ui:VisualElement>
                        <ui:VisualElement class="trade-quote-card sell-card">
                            <ui:Label text="PAID SALE TO MARKET" class="eyebrow" />
                            <ui:Label name="sellPreviewLabel" class="trade-exact" />
                            <ui:Button name="sellButton" text="Sell now" />
                        </ui:VisualElement>
                        <ui:VisualElement class="trade-quote-card">
                            <ui:Label text="LOAD / UNLOAD · NO CASH" class="eyebrow" />
                            <ui:Label name="harborTransferPreview" class="help" />
                            <ui:VisualElement class="row run-actions">
                                <ui:Button name="harborUnloadButton" text="Unload → local stock" />
                                <ui:Button name="harborLoadButton" text="Load → ship" />
                                <ui:Button name="harborMaxUnload" text="Max unload" />
                                <ui:Button name="harborMaxLoad" text="Max load" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Foldout name="harborCalculations" text="Exact price calculation" value="false">
                            <ui:Label name="buyCalculation" class="help" />
                            <ui:Label name="sellCalculation" class="help" />
                        </ui:Foldout>
                        <ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                  </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement class="modal-footer">
                    <ui:Label name="tradeAvailabilityLabel" class="modal-explanation" />
                    <ui:Button name="tradeSailButton" text="Sail here" />
                    <ui:Button name="harborDisableRoute" text="Pause ship automation" class="hidden" />
                </ui:VisualElement>
                <ui:Label name="tradeStatusLabel" class="modal-status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="industryBackdrop" class="modal-backdrop hidden">
            <ui:VisualElement name="industryDialog" class="industry-modal" focusable="true">
                <ui:VisualElement class="modal-heading">
                    <ui:VisualElement class="modal-heading-copy">
                        <ui:Label text="YOUR ENTERPRISE" class="eyebrow" />
                        <ui:Label name="industryTitle" class="modal-title" />
                    </ui:VisualElement>
                    <ui:Button name="closeIndustryButton" text="Close  ×" />
                </ui:VisualElement>
                <ui:VisualElement class="construction-bar">
                    <ui:DropdownField name="blueprintDropdown" label="Invest in" />
                    <ui:Label name="constructionLabel" class="construction-summary" />
                    <ui:Button name="constructButton" text="Construct" class="primary" />
                </ui:VisualElement>
                <ui:Foldout name="constructionRulesFoldout" text="Construction timing and charter grants" value="false" class="construction-rules">
                    <ui:ScrollView name="constructionRulesScroll" mode="Vertical" class="construction-rules-scroll">
                        <ui:Label name="constructionTimingLabel" class="help" />
                        <ui:Label name="industryEligibilityLabel" class="help" />
                    </ui:ScrollView>
                </ui:Foldout>
                <ui:DropdownField name="facilityDropdown" label="Your facility" />
                <ui:Button name="industryHarborButton" text="Open Harbor · shared stock, paid trading &amp; cargo" />
                <ui:Label name="noFacilityLabel" text="Choose an investment above. Public industries and public market stock remain separate from your company." class="summary" />
                <ui:VisualElement name="facilityBody" class="industry-body hidden">
                    <ui:ScrollView name="industryPolicyScroll" mode="Vertical" class="industry-policy">
                        <ui:Label name="facilityStateLabel" class="industry-state industry-summary" />
                        <ui:Label name="facilityScheduleLabel" class="help" />
                        <ui:Label name="industryAppliedPolicyLabel" class="help" />
                        <ui:Button name="recommendIndustryPresetButton" text="Prepare recommended input draft" />
                        <ui:Label name="industryPolicyDraftLabel" class="industry-state" />
                        <ui:Foldout name="industryDraftFoldout" text="Review proposed purchases and sales" value="false">
                            <ui:Label name="industryPolicyPreviewLabel" class="help policy-preview" />
                        </ui:Foldout>
                        <ui:Button name="applyIndustryPolicy" text="Apply operating policy" class="primary" />
                        <ui:Foldout name="industryAdvancedFoldout" text="Inputs, shipping, limits and accounting" value="false">
                        <ui:Foldout name="industryShippingFoldout" text="Physical shipping connection" value="false">
                            <ui:Label name="industryShippingLabel" class="help" />
                            <ui:Button name="industryShippingButton" text="Connect / inspect industrial shipping" />
                        </ui:Foldout>
                        <ui:Foldout name="industryInputsFoldout" text="Input availability and exact quotes" value="false">
                            <ui:Label name="facilityInputStatusLabel" class="help" />
                        </ui:Foldout>
                        <ui:Foldout name="industryDetailsFoldout" text="Edit detailed operating limits" value="false">
                            <ui:Toggle name="facilityEnabled" label="Operate facility" />
                            <ui:Toggle name="procurementEnabled" label="Buy local inputs automatically" />
                            <ui:VisualElement name="inputPolicyRows" />
                            <ui:TextField name="industryCashReserve" label="Retain cash" value="100" />
                            <ui:Toggle name="salesEnabled" label="Sell surplus output automatically" />
                            <ui:VisualElement name="outputPolicyRows" />
                            <ui:Label text="These are draft rules. Review the preview above, then Apply. Each configured good has at most one automatic local transaction per daily phase." class="help" />
                        </ui:Foldout>
                        <ui:Foldout name="industryFinancesFoldout" text="Recipe and actual finances" value="false">
                            <ui:Label name="facilityRecipeLabel" class="summary" />
                            <ui:Label name="facilityStatsLabel" class="help" />
                        </ui:Foldout>
                        </ui:Foldout>
                    </ui:ScrollView>
                    <ui:ScrollView name="industryStorageScroll" mode="Vertical" class="industry-storage">
                        <ui:Label name="storageCapacityLabel" class="summary" />
                        <ui:VisualElement class="row storage-input">
                            <ui:DropdownField name="storageGoodDropdown" label="Good" />
                            <ui:TextField name="storageQuantity" label="Qty" value="1" />
                        </ui:VisualElement>
                        <ui:Label name="storageSelectedStock" class="summary" />
                        <ui:Label name="transferAvailabilityLabel" class="help" />
                        <ui:VisualElement class="row">
                            <ui:Button name="shipToWarehouse" text="Ship → private storage" />
                            <ui:Button name="warehouseToShip" text="Private storage → ship" />
                        </ui:VisualElement>
                        <ui:Label text="Transfers keep ownership. No cash or day changes." class="transfer-note" />
                        <ui:Label text="LOCAL MARKET TRADE · OWNERSHIP AND CASH CHANGE" class="section-label" />
                        <ui:VisualElement class="row">
                            <ui:VisualElement class="warehouse-quote">
                                <ui:Label name="warehouseBuyPreview" class="help" />
                                <ui:Button name="warehouseBuy" text="Buy into private storage" class="primary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="warehouse-quote">
                                <ui:Label name="warehouseSellPreview" class="help" />
                                <ui:Button name="warehouseSell" text="Sell private stock locally" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Local facility trades can be managed remotely. Goods stay at this town; moving them elsewhere requires your ship." class="help" />
                        <ui:Foldout name="storageAllGoods" text="All commodity stocks" value="false">
                            <ui:VisualElement class="storage-row storage-header">
                                <ui:Label text="COMMODITY" class="trade-good-name" />
                                <ui:Label text="YOUR SHIP" class="storage-cell" />
                                <ui:Label text="PRIVATE" class="storage-cell" />
                                <ui:Label text="PUBLIC" class="storage-cell" />
                            </ui:VisualElement>
                            <ui:VisualElement name="storageRows" />
                        </ui:Foldout>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:Label name="industryStatusLabel" class="modal-status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
