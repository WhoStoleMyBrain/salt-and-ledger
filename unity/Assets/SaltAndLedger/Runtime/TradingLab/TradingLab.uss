.trading-lab {
    flex-grow: 1;
    background-color: #101b26;
    color: #e4edf3;
    padding: 14px;
    font-size: 14px;
}
.heading, .metrics, .toolbar, .columns, .row, .map-ports, .market-row {
    flex-direction: row;
    align-items: center;
}
.heading { margin-bottom: 8px; }
.heading .unity-label { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
.title { font-size: 26px; -unity-font-style: bold; color: #f0c77b; }
.subtitle { margin-left: 18px; color: #a9bccb; flex-grow: 1; }
.eyebrow { color: #82b9c7; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.metrics { margin-bottom: 8px; align-items: stretch; }
.metric { flex-grow: 1; flex-basis: 0; padding: 7px 12px; background-color: #1a2b39; margin-right: 8px; border-radius: 5px; }
.metric .unity-label { margin: 0; padding: 0; }
.metric .metric-value { margin-top: 3px; margin-bottom: 3px; }
.metric-value { font-size: 19px; -unity-font-style: bold; margin-top: 2px; white-space: normal; }
.metric-detail { font-size: 12px; color: #b5c8d4; white-space: normal; }
.toolbar { margin-bottom: 10px; }
.scenario-picker { flex-grow: 1; max-width: 450px; margin-right: 8px; }
.toolbar-note { flex-grow: 1; color: #a9bccb; margin-left: 12px; white-space: normal; }
.columns { flex-grow: 1; min-height: 0; align-items: stretch; }
.column { flex-grow: 1; flex-basis: 0; min-width: 0; background-color: #172632; border-radius: 6px; margin-right: 10px; }
.last-column { margin-right: 0; }
.column .unity-scroll-view__content-container { padding: 12px; }
.column .unity-scroll-view__content-viewport { min-width: 0; }
.section-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 10px; }
.subheading { font-size: 15px; -unity-font-style: bold; margin-top: 14px; margin-bottom: 6px; color: #f0c77b; }
.body { white-space: normal; margin-bottom: 5px; }
.muted { color: #a9bccb; font-size: 12px; white-space: normal; }
.help { color: #b5c8d4; font-size: 12px; white-space: normal; margin-top: 6px; margin-bottom: 6px; }
.card { background-color: #213644; border-radius: 5px; padding: 8px; margin-top: 8px; }
.card .unity-label { margin-left: 0; margin-right: 0; padding: 0; }
.preview-title { -unity-font-style: bold; color: #8ed5bb; margin-bottom: 5px; }
.preview-copy { white-space: normal; min-height: 45px; }
.warning { color: #ffd08a; }
.success { color: #8ed5bb; }
.status { white-space: normal; font-size: 13px; padding-top: 9px; min-height: 26px; }
.error { color: #ffb0a7; }
.row { align-items: stretch; }
.row > .unity-base-field, .row > .field-block, .row > .unity-button { flex-grow: 1; flex-basis: 0; min-width: 0; }
.row > .field-block { margin-right: 8px; }
.manual-inputs { margin-top: 8px; }
.manual-inputs .unity-base-field__label { min-width: 42px; }
.manual-inputs > .unity-base-field { margin-right: 6px; }
.field-caption { font-size: 12px; color: #b5c8d4; margin-top: 7px; margin-bottom: 2px; }
.unity-base-field { margin: 2px 0; min-height: 29px; }
.unity-base-field__label { min-width: 75px; color: #b5c8d4; padding-top: 5px; }
.unity-base-field__input { background-color: #0d1e2a; color: #edf5f9; border-width: 1px; border-color: #4d6a7d; border-radius: 3px; padding: 4px 8px; min-height: 28px; }
.unity-base-field__input:focus { border-color: #e5be77; }
.unity-base-text-field__input { -unity-text-align: middle-left; }
.unity-base-popup-field__input { flex-direction: row; align-items: center; }
.unity-base-popup-field__text { flex-grow: 1; }
.unity-base-popup-field__arrow { width: 8px; height: 8px; background-color: #8fb0c2; border-radius: 4px; margin-left: 8px; }
.unity-button { background-color: #304c60; color: #f1f5f7; border-width: 1px; border-color: #59788b; border-radius: 4px; margin: 4px 4px 0 0; min-height: 31px; padding: 6px 9px; white-space: normal; -unity-text-align: middle-center; }
.unity-button:hover { background-color: #41647a; border-color: #8bb7c5; }
.unity-button:active { background-color: #4a7187; }
.unity-button:focus { border-color: #f0c77b; }
.unity-button:disabled { background-color: #22333e; color: #8a9ca8; border-color: #394c59; }
.primary-button { background-color: #356c62; border-color: #67a895; }
.primary-button:hover { background-color: #418576; }
.accent-button { background-color: #6d5836; border-color: #bb9353; }
.accent-button:hover { background-color: #876e42; }
.selected-port { border-color: #f0c77b; border-width: 2px; color: #ffe0a7; }
.map-ports { justify-content: space-between; }
.map-ports > .unity-button { flex-grow: 1; }
.map-connection { height: 28px; margin-top: 10px; margin-bottom: 8px; }
.map-connection .unity-progress-bar__container { height: 28px; background-color: #0d1e2a; border-radius: 4px; border-width: 1px; border-color: #4b7180; }
.map-connection .unity-progress-bar__background { height: 26px; background-color: #0d1e2a; }
.map-connection .unity-progress-bar__progress { height: 26px; background-color: #377b81; }
.map-connection .unity-progress-bar__title-container { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; }
.map-connection .unity-progress-bar__title { -unity-text-align: middle-center; color: #ffffff; font-size: 12px; }
.ship-status { white-space: normal; color: #8ed5bb; -unity-font-style: bold; }
.market-row { border-bottom-width: 1px; border-bottom-color: #38505e; padding-top: 7px; padding-bottom: 7px; }
.market-good { flex-grow: 1; flex-basis: 0; }
.market-cell { width: 67px; -unity-text-align: middle-right; }
.market-header { color: #9cb9ca; font-size: 11px; }
.market-header .market-good { color: #9cb9ca; }
.market-good-name { -unity-font-style: bold; }
.pricing-details { margin-top: 9px; }
.unity-foldout__toggle { min-height: 26px; }
.unity-foldout__content { margin-left: 6px; }
.automation-switch { margin-bottom: 6px; }
.automation-switch .unity-base-field__label { flex-grow: 1; -unity-font-style: bold; color: #e4edf3; }
.automation-switch .unity-toggle__input { flex-grow: 0; min-width: 26px; min-height: 26px; padding: 4px; }
.unity-toggle__checkmark { width: 16px; height: 16px; border-radius: 3px; background-color: #12232f; border-width: 1px; border-color: #7393a5; }
.unity-toggle__input:checked .unity-toggle__checkmark { background-color: #8ed5bb; border-color: #b4ffe2; }
.decision { white-space: normal; }
.activity-entry { white-space: normal; font-size: 12px; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: #304754; }
.column .unity-scroller { background-color: #12212c; border-width: 0; padding: 0; margin: 0; }
.column .unity-scroller--vertical { width: 12px; min-width: 12px; max-width: 12px; }
.column .unity-scroller--vertical .unity-scroller__slider { width: 12px; min-width: 0; }
.column .unity-scroller .unity-base-field { border-width: 0; padding: 0; margin: 0; min-height: 0; }
.column .unity-scroller .unity-base-field__input { border-width: 0; border-radius: 0; padding: 0; min-height: 0; min-width: 0; background-color: #12212c; }
.column .unity-scroller .unity-base-slider__tracker { background-image: none; background-color: #12212c; border-width: 0; }
.column .unity-scroller .unity-base-slider__dragger { background-image: none; background-color: #527084; border-width: 0; border-radius: 4px; }
.column .unity-scroller .unity-base-slider__dragger-border { background-image: none; background-color: transparent; border-width: 0; }
.column .unity-scroller .unity-button { min-height: 0; padding: 0; margin: 0; border-width: 0; }
